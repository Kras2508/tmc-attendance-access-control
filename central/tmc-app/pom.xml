<?xml version="1.0" encoding="UTF-8"?>
<!--
  The single deployable unit of the central quantum (ADR-01, ADR-08): Docker image tmc-app.
  Composition root only. Also hosts the architecture tests (ArchUnit) that enforce the module rules.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>vn.tmc</groupId>
        <artifactId>tmc-platform</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>tmc-app</artifactId>
    <name>tmc-app (central application, deployable unit)</name>

    <dependencies>
        <dependency><groupId>vn.tmc</groupId><artifactId>shared-kernel</artifactId></dependency>
        <dependency><groupId>vn.tmc</groupId><artifactId>qr-token-lib</artifactId></dependency>
        <dependency><groupId>vn.tmc</groupId><artifactId>audit</artifactId></dependency>
        <dependency><groupId>vn.tmc</groupId><artifactId>access-management</artifactId></dependency>
        <dependency><groupId>vn.tmc</groupId><artifactId>identity-qr</artifactId></dependency>
        <dependency><groupId>vn.tmc</groupId><artifactId>attendance</artifactId></dependency>
        <dependency><groupId>vn.tmc</groupId><artifactId>gate-access</artifactId></dependency>
        <dependency><groupId>vn.tmc</groupId><artifactId>reporting-export</artifactId></dependency>
        <dependency><groupId>vn.tmc</groupId><artifactId>adapter</artifactId></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-actuator</artifactId></dependency>
        <dependency><groupId>org.flywaydb</groupId><artifactId>flyway-core</artifactId></dependency>
        <dependency><groupId>org.flywaydb</groupId><artifactId>flyway-database-postgresql</artifactId></dependency>
        <dependency><groupId>org.postgresql</groupId><artifactId>postgresql</artifactId><scope>runtime</scope></dependency>
        <dependency><groupId>com.tngtech.archunit</groupId><artifactId>archunit-junit5</artifactId><scope>test</scope></dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
