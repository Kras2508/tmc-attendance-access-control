# Copy this file to ".env" and adjust the values:  cp .env.example .env
# ".env" is git-ignored: never commit real passwords.
# Used by docker-compose (automatically) and by tmc-app / kiosk-app when started with ./mvnw.

# ---------- Database (PostgreSQL) ----------
POSTGRES_DB=tmc
POSTGRES_USER=tmc
POSTGRES_PASSWORD=tmc
POSTGRES_PORT=5432

# tmc-app connection (localhost when the app runs with ./mvnw; docker-compose overrides the host to "postgres")
TMC_DB_URL=jdbc:postgresql://localhost:5432/tmc
TMC_DB_USER=tmc
TMC_DB_PASSWORD=tmc

# ---------- tmc-app ----------
TMC_APP_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# External systems (mock URLs in dev; real ones are provided by TMC)
TMC_TURNSTILE_URL=http://localhost:9001
TMC_HRPAYROLL_URL=http://localhost:9002

# ---------- kiosk-app ----------
KIOSK_ID=BD-GATE-01
KIOSK_GATE_ID=BD-G01
KIOSK_CENTRAL_URL=http://localhost:8080
KIOSK_TURNSTILE_URL=http://localhost:9001
KIOSK_DATA_DIR=./data
