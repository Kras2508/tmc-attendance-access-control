<?xml version="1.0" encoding="UTF-8"?>
<!--
  TMC QR Attendance & Access Control — root Maven reactor.

  One reactor, TWO architecture quanta (report §3.1.2):
    * central/tmc-app  – the modular monolith (ADR-01): 7 modules packaged into ONE deployable unit
    * kiosk/kiosk-app  – the autonomous gate kiosk (ADR-03), deployed separately on every gate lane

  Every architecture module of the module view (Figure 1) is its own Maven module, so the allowed
  "use" dependencies of Figure 1 are declared explicitly in each pom.xml and Maven rejects cycles at build time.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.6</version>
        <relativePath/>
    </parent>

    <groupId>vn.tmc</groupId>
    <artifactId>tmc-platform</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>TMC Platform (reactor)</name>

    <modules>
        <!-- shared libraries -->
        <module>shared/shared-kernel</module>
        <module>shared/qr-token-lib</module>

        <!-- quantum 1: central application (modular monolith) -->
        <module>central/modules/audit</module>
        <module>central/modules/access-management</module>
        <module>central/modules/identity-qr</module>
        <module>central/modules/attendance</module>
        <module>central/modules/gate-access</module>
        <module>central/modules/reporting-export</module>
        <module>central/modules/adapter</module>
        <module>central/tmc-app</module>

        <!-- quantum 2: gate kiosk (edge) -->
        <module>kiosk/kiosk-app</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <archunit.version>1.3.0</archunit.version>
        <sqlite-jdbc.version>3.46.1.3</sqlite-jdbc.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- internal modules -->
            <dependency><groupId>vn.tmc</groupId><artifactId>shared-kernel</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>vn.tmc</groupId><artifactId>qr-token-lib</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>vn.tmc</groupId><artifactId>audit</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>vn.tmc</groupId><artifactId>access-management</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>vn.tmc</groupId><artifactId>identity-qr</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>vn.tmc</groupId><artifactId>attendance</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>vn.tmc</groupId><artifactId>gate-access</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>vn.tmc</groupId><artifactId>reporting-export</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>vn.tmc</groupId><artifactId>adapter</artifactId><version>${project.version}</version></dependency>

            <!-- third party -->
            <dependency><groupId>com.tngtech.archunit</groupId><artifactId>archunit-junit5</artifactId><version>${archunit.version}</version></dependency>
            <dependency><groupId>org.xerial</groupId><artifactId>sqlite-jdbc</artifactId><version>${sqlite-jdbc.version}</version></dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- every module gets the same test stack -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
